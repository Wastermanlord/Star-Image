{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Star Image",
  "version": "1.1.0",
  "identifier": "com.proyectoastral.starimage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Star Image",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {}
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQkJFN0JCNjVEOTE0ODYKUldTR0ZObGx1K2U3a3k4TGQzQVpYOGgvbHdTdmVkbGlZVkJpenZ0b055RzdoTGxMVWt1UlZTaVEK",
      "endpoints": [
        "https://github.com/Wastermanlord/Star-Image/releases/latest/download/updater.json"
      ]
    }
  }
}
